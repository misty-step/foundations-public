{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foundations",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "foundations.mistystep.io", "custom_domain": true }
  ]
}
